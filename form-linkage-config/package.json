{
  "name": "antd-form-linkage",
  "version": "2.0.2",
  "description": "Antd form linkage components",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "style": "dist/styles.css",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "vite",
    "build:demo": "vite build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "antd": ">=4.20.0",
    "lodash": ">=4.17.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^21.0.1",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@rollup/plugin-typescript": "^8.3.0",
    "@types/lodash": "^4.14.178",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "antd": "^4.24.0",
    "lodash": "^4.17.21",
    "postcss": "^8.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^2.70.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.3.1",
    "typescript": "^4.5.5",
    "vite": "^5.0.12"
  },
  "dependencies": {
  }
}
